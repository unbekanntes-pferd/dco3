# required env variables for E2E testing (tests/e2e) - tests are reported as ignored if missing
# dedicated local test user (no MFA) - roles: room manager, user manager, group manager
E2E_BASE_URL={your DRACOON domain, e.g. https://dracoon.team}
E2E_USER_NAME={your local e2e user username}
E2E_PASSWORD={your local e2e user password}

# optional
CLIENT_ID={OAuth client id - default: dracoon_legacy_scripting}
CLIENT_SECRET={OAuth client secret - default: empty}
E2E_EMAIL_DOMAIN={email domain for created test users - default: example.com}
# encrypted tests - REPLACES the e2e user's keypair per run (random secret)
E2E_CRYPTO={1 to enable - default: disabled}
